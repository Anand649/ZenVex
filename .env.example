# Copy to .env (never commit .env). Defaults work out of the box.
# Export for Uvicorn or pass --env-file. Same-origin production can use an empty value.
ZENVEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: path to a trained baseline model
# ZENVEX_MODEL_PATH=backend/models/baseline.joblib
